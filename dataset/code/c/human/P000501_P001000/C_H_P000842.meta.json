    "title": "Maximum Value at a Given Index in a Bounded Array",
    "category": "Binary Search",
    "difficulty": "Hard",
    "problemStatement": "Construct an array of length n consisting of positive integers such that: Adjacent elements differ by at most 1. The sum of all elements does not exceed maxSum. Return the maximum possible value at the given index.",
    "input": "Integer n Integer index Integer maxSum",
    "output": "The maximum possible value.",
    "constraints": "1 <= n <= 10^9 0 <= index < n n <= maxSum <= 10^9"
