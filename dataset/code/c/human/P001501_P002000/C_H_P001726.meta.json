  "problem": {
    "problemId": "P001726",
    "title": "Count Downward Paths with Sum K",
    "category": "Trees",
    "difficulty": "Hard",
    "problemStatement": "Given a binary tree whose nodes contain integer values and an integer K, determine the number of downward paths whose node values sum to exactly K. A path may start and end at any nodes but must always move from parent to child.",
    "input": "\u2022 The first line contains an integer N. \u2022 The second line contains the node values. \u2022 The next N lines describe the binary tree. \u2022 The last line contains K.",
    "output": "\u2022 Print the number of qualifying paths.",
    "constraints": "\u2022 1 \u2264 N \u2264 2 \u00d7 10^5 \u2022 \u221210^9 \u2264 NodeValue \u2264 10^9"
  },
