  "problem": {
    "problemId": "P001677",
    "title": "Find the Cousins of a Given Node",
    "category": "Trees",
    "difficulty": "Medium",
    "problemStatement": "Given the root of a binary tree and a target node, determine all cousin nodes of the target. Two nodes are cousins if they are at the same depth but have different parents.",
    "input": "\u2022 The first line contains an integer N. \u2022 The next N lines describe the binary tree. \u2022 The last line contains the target node.",
    "output": "\u2022 Print all cousin nodes in the required order. If none exist, print NONE.",
    "constraints": "\u2022 1 \u2264 N \u2264 2 \u00d7 10^5"
  },
