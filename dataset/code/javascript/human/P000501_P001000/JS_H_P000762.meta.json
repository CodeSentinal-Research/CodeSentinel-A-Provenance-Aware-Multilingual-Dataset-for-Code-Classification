    "title": "Wildcard Pattern Matching",
    "category": "Recursion",
    "difficulty": "Hard",
    "problemStatement": "Given a string s and a pattern p containing lowercase letters, '?', and '*': '?' matches exactly one character. '*' matches any sequence of characters (including the empty sequence). Determine whether the entire string matches the pattern using recursion.",
    "input": "String s String p",
    "output": "true if the pattern matches the string, otherwise false.",
    "constraints": "1 <= |s|, |p| <= 200"
