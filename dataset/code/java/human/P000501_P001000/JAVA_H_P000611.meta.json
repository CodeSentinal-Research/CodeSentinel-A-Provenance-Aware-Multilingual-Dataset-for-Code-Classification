  "problem": {
    "problemId": "P000611",
    "title": "Maximum Twin Sum of a Linked List",
    "category": "Linked List",
    "difficulty": "Easy",
    "problemStatement": "A linked list of even length has twin nodes defined as follows: The first node is the twin of the last node. The second node is the twin of the second-last node. And so on. The twin sum of a pair is the sum of their values. Return the maximum twin sum among all twin pairs.",
    "input": "Integer n (always even) Linked list",
    "output": "A single integer representing the maximum twin sum.",
    "constraints": "2 <= n <= 10^5 1 <= node.value <= 10^5"
  },
