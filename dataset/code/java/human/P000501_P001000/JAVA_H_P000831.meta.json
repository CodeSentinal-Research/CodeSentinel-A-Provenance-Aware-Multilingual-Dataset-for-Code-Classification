    "title": "Minimum Number of Days to Make m Bouquets",
    "category": "Binary Search",
    "difficulty": "Medium",
    "problemStatement": "You are given an array bloomDay, where bloomDay[i] is the day the i-th flower blooms. Each bouquet requires k adjacent flowers. Return the minimum number of days required to make exactly m bouquets, or -1 if it is impossible.",
    "input": "Integer n Array bloomDay Integer m Integer k",
    "output": "The minimum required day.",
    "constraints": "1 <= n <= 10^5 1 <= bloomDay[i] <= 10^9"
