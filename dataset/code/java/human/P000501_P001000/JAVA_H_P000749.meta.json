  "problem": {
    "problemId": "P000749",
    "title": "Generate All Paths with Variable Length Jumps",
    "category": "Recursion",
    "difficulty": "Hard",
    "problemStatement": "Given an N \u00d7 M grid, generate all possible paths from the top-left cell to the bottom-right cell. From any cell, you may move: Horizontally right by any positive number of cells (Hk) Vertically down by any positive number of cells (Vk) Diagonally down-right by any positive number of cells (Dk) where k denotes the jump length. Print all valid paths in lexicographical order.",
    "input": "Integer N Integer M",
    "output": "All valid paths.",
    "constraints": "1 <= N, M <= 10"
