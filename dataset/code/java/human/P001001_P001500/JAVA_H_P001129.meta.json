  "problem": {
    "problemId": "P001129",
    "title": "Remove Maximum Number of Edges While Keeping Graph Fully Traversable",
    "category": "Graphs",
    "difficulty": "Hard",
    "problemStatement": "A graph contains three types of edges: \u2022 Type 1: Usable only by Alice. \u2022 Type 2: Usable only by Bob. \u2022 Type 3: Usable by both Alice and Bob. Determine the maximum number of edges that can be removed while ensuring both Alice and Bob can still traverse the entire graph. If impossible, print -1.",
    "input": "\u2022 First line contains integers N and M. \u2022 Next M lines each contain type, u, and v.",
    "output": "Print the maximum number of removable edges.",
    "constraints": "\u2022 2 \u2264 N \u2264 10^5 \u2022 1 \u2264 M \u2264 2\u00d710^5"
  },
