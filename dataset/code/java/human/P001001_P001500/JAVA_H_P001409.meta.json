    "title": "Count Equal and Divisible Pairs",
    "category": "Hashing",
    "difficulty": "Easy",
    "problemStatement": "Given an integer array and an integer K, count pairs (i, j) such that i < j, nums[i] = nums[j], and (i \u00d7 j) is divisible by K.",
    "input": "\u2022 First line contains integers N and K. \u2022 Second line contains N integers.",
    "output": "Print the total number of valid pairs.",
    "constraints": "\u2022 1 \u2264 N \u2264 10^5"
