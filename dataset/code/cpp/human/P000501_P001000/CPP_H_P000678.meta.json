  "problem": {
    "problemId": "P000678",
    "title": "Josephus Problem Using Circular Linked List",
    "category": "Linked List",
    "difficulty": "Hard",
    "problemStatement": "There are n people standing in a circle numbered from 1 to n. Starting from the first person, every k-th remaining person is eliminated until only one person remains. Simulate the process using a circular linked list and return the label of the survivor.",
    "input": "Integer n Integer k",
    "output": "The label of the last remaining person.",
    "constraints": "1 <= n <= 10^5 1 <= k <= 10^5"
  },
